generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ANALYST
  DEVELOPER
  QA
  PROJECT_MANAGER
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ProjectStatus {
  ACTIVE
  REVIEW
  COMPLETED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AnalysisStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum FindingType {
  CONFLICT
  DUPLICATE
  AMBIGUITY
  TRACEABILITY
  CONSISTENCY
}

enum FindingStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
  WONT_FIX
}

enum RequirementStatus {
  DRAFT
  READY_FOR_REVIEW
  UNDER_REVIEW
  APPROVED
  REJECTED
  RELEASED
}

enum OrganizationRole {
  OWNER
  ADMIN
  PROJECT_MANAGER
  BUSINESS_ANALYST
  DEVELOPER
  QA_ENGINEER
  CLIENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  DEVELOPER
  REVIEWER
  VIEWER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum ActivityType {
  LOGIN
  UPLOAD
  ANALYSIS
  REPORT
  SETTINGS
  TEAM
  PROJECT
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model User {
  id                           String                   @id @default(cuid())
  fullName                     String
  username                     String                   @unique
  email                        String?                  @unique
  password                     String?
  emailVerified                DateTime?
  image                        String?
  coverImage                   String?
  website                      String?
  firstName                    String?
  lastName                     String?
  displayName                  String?
  role                         Role                     @default(DEVELOPER)
  provider                     String?
  accounts                     Account[]
  sessions                     Session[]
  projects                     Project[]
  analyses                     Analysis[]
  findings                     Finding[]                @relation("FindingAssignee")
  memberships                  ProjectMember[]
  ownedRequirements            Requirement[]            @relation("RequirementOwner")
  requirementVersions          RequirementVersion[]
  organizationMemberships      OrganizationMember[]
  ownedOrganizations           Organization[]           @relation("OrganizationOwner")
  sentInvitations              OrganizationInvitation[] @relation("InvitationSender")
  requirementComments          RequirementComment[]
  requirementApprovals         RequirementApproval[]
  activities                   ActivityLog[]
  notifications                Notification[]
  settings                     UserSettings?
  apiKeys                      ApiKey[]
  recoveryCodes                RecoveryCode[]
  supportArticles             SupportArticle[]
  supportFeedback             SupportFeedback[]
  supportTickets              SupportTicket[]
  supportMessages             SupportMessage[]
  findingAudits               FindingAudit[]
  jobTitle                     String?
  department                   String?
  location                     String?
  phone                        String?
  workspaceMemberships         WorkspaceMember[]
  ownedWorkspaces              Workspace[]              @relation("WorkspaceOwner")
  sentWorkspaceInvitations     WorkspaceInvitation[]    @relation("WorkspaceInvitationSender")
  receivedWorkspaceInvitations WorkspaceInvitation[]    @relation("WorkspaceInvitationRecipient")
  comments                     FindingComment[]
  reports                      Report[]
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  passwordChangedAt            DateTime?
  lastLoginAt                  DateTime?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expires      DateTime
  ip           String?
  ipAddress    String?
  userAgent    String?
  deviceName   String?
  deviceType   String?
  browser      String?
  os           String?
  lastActiveAt DateTime?
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, lastActiveAt])
}

model VerificationToken {
  id          String                @id @default(cuid())
  token       String                @unique
  hashedToken String
  type        VerificationTokenType
  identifier  String
  expires     DateTime
  used        Boolean               @default(false)
  createdAt   DateTime              @default(now())
}

model Project {
  id             String          @id @default(cuid())
  organizationId String?
  workspaceId    String?
  name           String
  client         String?
  description    String?
  status         ProjectStatus   @default(ACTIVE)
  priority       Priority        @default(MEDIUM)
  dueDate        DateTime?
  ownerId        String
  owner          User            @relation(fields: [ownerId], references: [id])
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  workspace      Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  members        ProjectMember[]
  analyses       Analysis[]
  reports        Report[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([workspaceId, createdAt])
}

model Organization {
  id          String                   @id @default(cuid())
  name        String
  slug        String                   @unique
  logoUrl     String?
  ownerId     String
  owner       User                     @relation("OrganizationOwner", fields: [ownerId], references: [id])
  members     OrganizationMember[]
  invitations OrganizationInvitation[]
  projects    Project[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(DEVELOPER)
  lastActiveAt   DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId, role])
}

model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           OrganizationRole @default(DEVELOPER)
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  invitedById    String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User             @relation("InvitationSender", fields: [invitedById], references: [id])
  createdAt      DateTime         @default(now())

  @@index([email, status])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Analysis {
  id               String         @id @default(cuid())
  projectId        String?
  ownerId          String
  project          Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  owner            User           @relation(fields: [ownerId], references: [id])
  fileName         String
  fileType         String?
  storageKey       String?
  status           AnalysisStatus @default(QUEUED)
  processingMs     Int?
  requirements     Int            @default(0)
  confidence       Float?
  consistency      Float?
  aiModel          String?
  summary          String?
  aiSummary       Json?
  aiRisks         Json?
  qualityBreakdown Json?
  testCases       Json?
  traceability    Json?
  errorMessage    String?
  engineVersion   String?
  issuesCount      Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  findings         Finding[]
  requirementsData Requirement[]
  reports          Report[]
}

model Requirement {
  id         String                @id @default(cuid())
  analysisId String
  ownerId    String?
  key        String
  text       String
  category   String?
  aiType     String?
  aiExplanation String?
  rewrite    String?
  testability String?
  implementationNotes String?
  priority   Priority              @default(MEDIUM)
  status     RequirementStatus     @default(DRAFT)
  version    Int                   @default(1)
  analysis   Analysis              @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  owner      User?                 @relation("RequirementOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  findings   Finding[]
  relatedFindings Finding[] @relation("RelatedFindingRequirement")
  versions   RequirementVersion[]
  comments   RequirementComment[]
  approvals  RequirementApproval[]

  @@index([analysisId, status])
}

model RequirementVersion {
  id            String            @id @default(cuid())
  requirementId String
  createdById   String
  version       Int
  text          String
  status        RequirementStatus
  changeSummary String?
  createdAt     DateTime          @default(now())
  requirement   Requirement       @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  createdBy     User              @relation(fields: [createdById], references: [id])

  @@unique([requirementId, version])
  @@index([requirementId, createdAt])
}

model RequirementComment {
  id            String               @id @default(cuid())
  requirementId String
  authorId      String
  parentId      String?
  body          String
  resolvedAt    DateTime?
  requirement   Requirement          @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  author        User                 @relation(fields: [authorId], references: [id])
  parent        RequirementComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       RequirementComment[] @relation("CommentReplies")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([requirementId, createdAt])
}

model RequirementApproval {
  id            String           @id @default(cuid())
  requirementId String
  reviewerId    String
  decision      ApprovalDecision
  comment       String?
  requirement   Requirement      @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  reviewer      User             @relation(fields: [reviewerId], references: [id])
  createdAt     DateTime         @default(now())

  @@index([requirementId, createdAt])
}

model Finding {
  id            String           @id @default(cuid())
  analysisId    String
  requirementId String?
  assigneeId    String?
  type          FindingType
  severity      Priority         @default(MEDIUM)
  confidence    Float?
  title         String
  description   String?
  suggestion    String?
  whyItMatters String?
  businessImpact String?
  evidence     String?
  testability  String?
  rewrite      String?
  relatedRequirementId String?
  status        FindingStatus    @default(OPEN)
  analysis      Analysis         @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  requirement   Requirement?     @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  relatedRequirement Requirement? @relation("RelatedFindingRequirement", fields: [relatedRequirementId], references: [id], onDelete: SetNull)
  assignee      User?            @relation("FindingAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments      FindingComment[]
  audits        FindingAudit[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model FindingComment {
  id        String   @id @default(cuid())
  findingId String
  authorId  String
  body      String
  attachment String?
  mentions   Json?
  finding   Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model FindingAudit {
  id        String   @id @default(cuid())
  findingId String
  actorId   String
  field     String
  fromValue String?
  toValue   String?
  metadata  Json?
  finding   Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([findingId, createdAt])
}

model Report {
  id         String    @id @default(cuid())
  projectId  String?
  analysisId String?
  ownerId    String
  name       String
  version    Int       @default(1)
  storageKey String?
  format     String    @default("CSV")
  snapshot   Json
  generatedAt DateTime @default(now())
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  analysis   Analysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  owner      User      @relation(fields: [ownerId], references: [id])
  createdAt  DateTime  @default(now())
}

model Workspace {
  id            String                @id @default(cuid())
  name          String
  slug          String                @unique
  logoUrl       String?
  ownerId       String
  owner         User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members       WorkspaceMember[]
  invitations   WorkspaceInvitation[]
  projects      Project[]
  activities    ActivityLog[]
  notifications Notification[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model WorkspaceMember {
  id           String        @id @default(cuid())
  workspaceId  String
  userId       String
  role         WorkspaceRole @default(DEVELOPER)
  lastActiveAt DateTime?
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([workspaceId, userId])
  @@index([workspaceId, role])
}

model WorkspaceInvitation {
  id          String                    @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole             @default(DEVELOPER)
  message     String?
  tokenHash   String                    @unique
  status      WorkspaceInvitationStatus @default(PENDING)
  expiresAt   DateTime
  invitedById String
  recipientId String?
  workspace   Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User                      @relation("WorkspaceInvitationSender", fields: [invitedById], references: [id])
  recipient   User?                     @relation("WorkspaceInvitationRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([workspaceId, status, createdAt])
  @@index([email, status])
}

model ActivityLog {
  id          String       @id @default(cuid())
  userId      String?
  workspaceId String?
  type        ActivityType
  title       String
  message     String?
  metadata    Json?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace   Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@index([workspaceId, createdAt])
}

model Notification {
  id          String     @id @default(cuid())
  userId      String
  workspaceId String?
  category    String
  title       String
  message     String?
  href        String?
  readAt      DateTime?
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@index([userId, readAt, createdAt])
}

model UserSettings {
  id             String   @id @default(cuid())
  userId         String   @unique
  bio            String?
  timezone       String   @default("UTC")
  language       String   @default("en")
  emailAlerts    Boolean  @default(true)
  pushAlerts     Boolean  @default(true)
  analysisAlerts Boolean  @default(true)
  reportAlerts   Boolean  @default(true)
  twoFactor      Boolean  @default(false)
  twoFactorSecretHash String?
  emailNotifications Boolean @default(true)
  pushNotifications  Boolean @default(true)
  inAppNotifications Boolean @default(true)
  emailAnalysisComplete Boolean @default(true)
  emailNewMember       Boolean @default(true)
  emailWeeklyReport    Boolean @default(true)
  emailSecurityAlerts  Boolean @default(true)
  pushMentions         Boolean @default(true)
  pushComments         Boolean @default(true)
  pushReports          Boolean @default(true)
  theme            String   @default("system")
  accentColor      String   @default("#e3b341")
  dateFormat       String   @default("MMM d, yyyy")
  weekStartsOn     Int      @default(1)
  profileVisibility String  @default("team")
  showActivity     Boolean  @default(true)
  organization   String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt      DateTime @updatedAt
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  name        String
  keyPrefix   String
  keyHash     String    @unique
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, createdAt])
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model SupportArticle {
  id          String            @id @default(cuid())
  title       String
  slug        String            @unique
  category    String
  kind        String            @default("article")
  excerpt     String
  content     String
  published   Boolean           @default(true)
  authorId    String?
  author      User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  feedback    SupportFeedback[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([category, published])
  @@index([kind, published])
}

model SupportFeedback {
  id        String         @id @default(cuid())
  articleId String
  userId    String
  helpful   Boolean
  article   SupportArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([articleId, userId])
}

model SupportTicket {
  id          String               @id @default(cuid())
  userId      String
  subject     String
  category    String
  priority    SupportTicketPriority @default(NORMAL)
  description String
  attachment  String?
  status      SupportTicketStatus  @default(OPEN)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation SupportConversation?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([userId, status, updatedAt])
}

model SupportConversation {
  id        String          @id @default(cuid())
  ticketId  String          @unique
  ticket    SupportTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  messages  SupportMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  senderId       String?
  body           String
  sender         User?               @relation(fields: [senderId], references: [id], onDelete: SetNull)
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}
